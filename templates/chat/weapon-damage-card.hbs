<section class="star-frontiers check-roll-card weapon-damage-card sf-damage-card">
  <header class="check-roll-card__header">
    <h3>{{title}}</h3>
    {{#if subtitle}}
      <p>{{subtitle}}</p>
    {{/if}}
  </header>

  <div class="check-roll-card__rows">
    {{#each rows as |row|}}
      <div class="check-roll-card__row">
        <span class="check-roll-card__label">{{row.label}}</span>
        <strong class="check-roll-card__value">{{row.value}}</strong>
      </div>
    {{/each}}
  </div>

  <div class="chat-card-actions sf-chat-card__apply-actions">
    <button
      type="button"
      class="sf-chat-action"
      data-action="applyDamage"
      data-apply-key="{{applyKey}}"
      data-target-actor-uuid="{{targetActorUuid}}"
      data-target-token-uuid="{{targetTokenUuid}}"
    >
      {{damageButtonLabel}}
    </button>
  </div>

  {{{rollHtml}}}
</section>

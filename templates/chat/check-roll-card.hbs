<section class="star-frontiers check-roll-card">
  <header class="check-roll-card__header">
    <h3>{{title}}</h3>
    {{#if subtitle}}
      <p>{{subtitle}}</p>
    {{/if}}
  </header>

  <div class="check-roll-card__rows">
    {{#each rows as |row|}}
      <div class="check-roll-card__row">
        <span class="check-roll-card__label">{{row.label}}</span>
        <strong class="check-roll-card__value">{{row.value}}</strong>
      </div>
    {{/each}}
  </div>

  {{#if outcome}}
    <div class="check-roll-card__outcome check-roll-card__outcome--{{outcomeClass}}">
      {{outcome}}
    </div>
  {{/if}}

  {{#if applyEffect}}
    <div class="chat-card-actions sf-chat-card__apply-actions">
      <button
        type="button"
        class="sf-chat-action"
        data-action="applyStatus"
        data-apply-key="{{applyEffect.applyKey}}"
        data-status-id="{{applyEffect.statusId}}"
        data-target-actor-uuid="{{applyEffect.targetActorUuid}}"
        data-target-token-uuid="{{applyEffect.targetTokenUuid}}"
      >
        {{localize "STARFRONTIERS.Chat.ApplyStatus" status=applyEffect.label}}
      </button>
    </div>
  {{/if}}

  {{{rollHtml}}}
</section>

<section class="star-frontiers-sheet star-frontiers-creature-sheet {{themeClass}}" data-rules-edition="{{rulesEdition}}" autocomplete="off">
  <header class="creature-header">
    <button
      type="button"
      class="creature-portrait actor-profile-image"
      data-action="editProfileImage"
      title="{{localize "STARFRONTIERS.Character.ChangeProfileImage"}}"
      aria-label="{{localize "STARFRONTIERS.Character.ChangeProfileImage"}}"
    >
      <img src="{{actor.img}}" alt="" />
    </button>
    <div class="creature-header__meta">
      <input class="creature-name-input" type="text" name="name" value="{{actor.name}}" />

      <div class="creature-line creature-line--type">
        <label class="inline-field">
          <span>{{localize "STARFRONTIERS.Creature.Size"}}</span>
          <select name="system.size">{{selectOptions sizeChoices selected=system.size localize=true}}</select>
        </label>
        <label class="inline-field">
          <span>{{localize "STARFRONTIERS.Creature.Type"}}</span>
          <select name="system.ecology">{{selectOptions ecologyChoices selected=system.ecology localize=true}}</select>
        </label>
        {{#if (eq system.ecology "other")}}
          <label class="inline-field inline-field--grow">
            <input
              type="text"
              name="system.ecologyOther"
              value="{{system.ecologyOther}}"
              placeholder="{{localize "STARFRONTIERS.Creature.TypeOtherPlaceholder"}}"
            />
          </label>
        {{/if}}
      </div>

      <div class="creature-line creature-line--habitat">
        <div class="inline-field creature-number">
          <button
            type="button"
            class="creature-field__roll-label"
            data-action="rollNumberAppearing"
            title="{{localize "STARFRONTIERS.Creature.RollNumberHint"}}"
          >
            <i class="fa-solid fa-dice-d10"></i> {{localize "STARFRONTIERS.Creature.Number"}}
          </button>
          <input type="text" name="system.groupSize.formula" value="{{system.groupSize.formula}}" placeholder="2-6" />
        </div>
        <label class="inline-field inline-field--grow">
          <span>{{localize "STARFRONTIERS.Creature.NativeWorld"}}</span>
          <input type="text" name="system.nativeWorld" value="{{system.nativeWorld}}" />
        </label>
        <label class="inline-field inline-field--grow">
          <span>{{localize "STARFRONTIERS.Creature.Habitat"}}</span>
          <input
            type="text"
            name="system.habitat"
            value="{{system.habitat}}"
            placeholder="{{localize "STARFRONTIERS.Creature.HabitatPlaceholder"}}"
          />
        </label>
      </div>
    </div>
  </header>

  <main class="creature-body">
    <fieldset class="paper-box full-width">
      <legend>{{localize "STARFRONTIERS.Creature.Movement"}}</legend>
      {{#if movementRows.length}}
        <div class="creature-list">
          {{#each movementRows as |row|}}
            <div class="creature-list-row creature-movement-row">
              <label class="inline-field small">
                <span>{{localize "STARFRONTIERS.Creature.Mode"}}</span>
                <select name="system.movement.{{row.index}}.mode">
                  {{selectOptions @root.movementModeChoices selected=row.mode localize=true}}
                </select>
              </label>
              {{#if (eq row.mode "other")}}
                <label class="inline-field inline-field--grow">
                  <input
                    type="text"
                    name="system.movement.{{row.index}}.modeOther"
                    value="{{row.modeOther}}"
                    placeholder="{{localize "STARFRONTIERS.Creature.MoveModeOtherPlaceholder"}}"
                  />
                </label>
              {{/if}}
              <label class="inline-field small">
                <span>{{localize "STARFRONTIERS.Creature.Speed"}}</span>
                <select name="system.movement.{{row.index}}.category">
                  {{selectOptions @root.movementCategoryChoices selected=row.category localize=true}}
                </select>
              </label>
              <label class="inline-field small">
                <span>{{localize "STARFRONTIERS.Creature.MetersPerTurn"}}</span>
                <input class="smallField" type="number" name="system.movement.{{row.index}}.ratePerTurn" value="{{row.ratePerTurn}}" min="0" />
              </label>
              <label class="inline-field small">
                <span>{{localize "STARFRONTIERS.Creature.Kilometers-abbr-PerHour"}}</span>
                <input class="smallField" type="number" name="system.movement.{{row.index}}.ratePerHour" value="{{row.ratePerHour}}" min="0" />
              </label>
              <label class="inline-field small inline-field--grow">
                <span>{{localize "STARFRONTIERS.Creature.MoveNotes"}}</span>
                <input
                  type="text"
                  name="system.movement.{{row.index}}.notes"
                  value="{{row.notes}}"
                  placeholder="{{localize "STARFRONTIERS.Creature.MoveNotesPlaceholder"}}"
                />
              </label>
              <button
                type="button"
                class="creature-row-remove"
                data-action="removeMovement"
                data-index="{{row.index}}"
                title="{{localize "STARFRONTIERS.Item.Delete"}}"
              >
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Creature.NoMovementModes"}}</p>
      {{/if}}
      <div class="section-controls">
        <button type="button" data-action="addMovement">
          <i class="fa-solid fa-plus"></i>
          <span>{{localize "STARFRONTIERS.Creature.AddMovement"}}</span>
        </button>
      </div>
    </fieldset>

    <fieldset class="paper-box full-width">
      <legend>{{localize "STARFRONTIERS.Creature.Combat"}}</legend>
      <div class="creature-line creature-line--combat">
        <label class="inline-field small">
          <span>{{localize "STARFRONTIERS.Creature.IM"}}</span>
          <input class="smallField" type="number" name="system.initiativeMod" value="{{system.initiativeMod}}" min="0" />
        </label>
        <label class="inline-field small">
          <span>{{localize "STARFRONTIERS.Creature.RS"}}</span>
          <input class="smallField" type="number" name="system.reactionSpeed" value="{{system.reactionSpeed}}" min="1" max="100" />
        </label>
        <label class="inline-field small creature-stamina-field">
          <span>{{localize "STARFRONTIERS.Creature.Stamina"}}</span>
          <span class="creature-stamina-pair">
            <input class="smallField" type="number" name="system.abilities.sta.value" value="{{staminaValue}}" />
            <span class="creature-stamina-pair__slash">/</span>
            <input class="smallField" type="number" name="system.abilities.sta.max" value="{{staminaMax}}" />
          </span>
          <div class="creature-label-pair">
              <div class="shim">&nbsp;</div>
              <div class="smallerLabel">{{localize "STARFRONTIERS.Creature.Current"}}</div>
              <span class="slashShim">&nbsp;&nbsp;</span>
              <div class="smallerLabel">{{localize "STARFRONTIERS.Creature.Max"}}</div>
          </div>
        </label>
        <label class="inline-field small">
          <span>{{localize "STARFRONTIERS.Creature.Attack"}}</span>
          <input class="smallField" type="number" name="system.attackScore" value="{{system.attackScore}}" min="0" max="100" />
        </label>
        <label class="inline-field small">
          <span>{{localize "STARFRONTIERS.Creature.AttacksPerTurn"}}</span>
          <input class="smallField" type="number" name="system.numAttacksPerTurn" value="{{system.numAttacksPerTurn}}" min="0" />
        </label>
      </div>
      <div class="creature-roll-row">
        <div class="roll-label-group roll-label-group--left">
          <button
            type="button"
            class="creature-field__roll-label"
            data-action="rollCreatureInitiative"
            title="{{localize "STARFRONTIERS.Creature.RollInitiativePublic"}}"
          >
            <i class="fa-solid fa-dice-d10"></i> {{localize "STARFRONTIERS.Creature.RollInitiative"}}
          </button>
          <div class="roll-label-actions">
            <button type="button" class="roll-label-action roll-label-action--blind" data-action="rollCreatureInitiative" data-roll-mode="blind" title="{{localize "STARFRONTIERS.Creature.RollInitiativeBlind"}}"></button>
            <button type="button" class="roll-label-action roll-label-action--gm" data-action="rollCreatureInitiative" data-roll-mode="gm" title="{{localize "STARFRONTIERS.Creature.RollInitiativeWhisper"}}"></button>
          </div>
        </div>
      </div>

      <div class="creature-subsection">
        <div class="creature-subsection__header">
          <h3>{{localize "STARFRONTIERS.Creature.NaturalWeapons"}}</h3>
          <button type="button" data-action="addNaturalWeapon">
            <i class="fa-solid fa-plus"></i>
            <span>{{localize "STARFRONTIERS.Creature.AddNaturalWeapon"}}</span>
          </button>
        </div>
        {{#if naturalWeapons.length}}
          <div class="creature-attack-list">
            {{#each naturalWeapons as |atk|}}
              <div class="creature-attack-row" data-item-id="{{atk.id}}">
                <div class="creature-attack-row__primary">
                  <div class="roll-label-group roll-label-group--left">
                    <button type="button" class="creature-attack-button" data-action="rollWeaponAttack" title="{{localize "STARFRONTIERS.Weapon.RollAttack"}}">{{atk.name}}</button>
                    <div class="roll-label-actions">
                      <button type="button" class="roll-label-action roll-label-action--blind" data-action="rollWeaponAttack" data-roll-mode="blind" title="{{localize "STARFRONTIERS.Weapon.RollAttackBlind"}}"></button>
                      <button type="button" class="roll-label-action roll-label-action--gm" data-action="rollWeaponAttack" data-roll-mode="gm" title="{{localize "STARFRONTIERS.Weapon.RollAttackWhisper"}}"></button>
                    </div>
                  </div>
                </div>
                <div class="creature-attack-row__damage-cell">
                  {{#if atk.hasDamage}}
                    <div class="roll-label-group roll-label-group--left">
                      <button type="button" class="creature-attack-button creature-attack-button--damage" data-action="rollWeaponDamage" title="{{localize "STARFRONTIERS.Weapon.RollDamage"}}">{{atk.damage}}</button>
                      <div class="roll-label-actions">
                        <button type="button" class="roll-label-action roll-label-action--blind" data-action="rollWeaponDamage" data-roll-mode="blind" title="{{localize "STARFRONTIERS.Weapon.RollDamageBlind"}}"></button>
                        <button type="button" class="roll-label-action roll-label-action--gm" data-action="rollWeaponDamage" data-roll-mode="gm" title="{{localize "STARFRONTIERS.Weapon.RollDamageWhisper"}}"></button>
                      </div>
                    </div>
                  {{else}}
                    <span class="creature-attack-button creature-attack-button--damage creature-attack-button--empty">{{atk.damage}}</span>
                  {{/if}}
                </div>
                <span class="creature-attack-row__defense">{{atk.defenseLabel}}</span>
                <div class="creature-attack-row__actions">
                  <button type="button" data-action="openItem" title="{{localize "STARFRONTIERS.Item.Open"}}">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>
                  <button type="button" data-action="deleteItem" title="{{localize "STARFRONTIERS.Item.Delete"}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Creature.NoNaturalWeapons"}}</p>
        {{/if}}
      </div>

      {{#if hasCarriedWeapons}}
        <div class="creature-subsection">
          <div class="creature-subsection__header">
            <h3>{{localize "STARFRONTIERS.Creature.CarriedWeapons"}}</h3>
          </div>
          <div class="creature-attack-list">
            {{#each carriedWeapons as |wpn|}}
              <div class="creature-attack-row" data-item-id="{{wpn.id}}">
                <div class="creature-attack-row__primary">
                  <div class="roll-label-group roll-label-group--left">
                    <button type="button" class="creature-attack-button" data-action="rollWeaponAttack" title="{{localize "STARFRONTIERS.Weapon.RollAttack"}}">{{wpn.name}}</button>
                    <div class="roll-label-actions">
                      <button type="button" class="roll-label-action roll-label-action--blind" data-action="rollWeaponAttack" data-roll-mode="blind" title="{{localize "STARFRONTIERS.Weapon.RollAttackBlind"}}"></button>
                      <button type="button" class="roll-label-action roll-label-action--gm" data-action="rollWeaponAttack" data-roll-mode="gm" title="{{localize "STARFRONTIERS.Weapon.RollAttackWhisper"}}"></button>
                    </div>
                  </div>
                </div>
                <div class="creature-attack-row__damage-cell">
                  {{#if wpn.hasDamage}}
                    <div class="roll-label-group roll-label-group--left">
                      <button type="button" class="creature-attack-button creature-attack-button--damage" data-action="rollWeaponDamage" title="{{localize "STARFRONTIERS.Weapon.RollDamage"}}">{{wpn.damage}}</button>
                      <div class="roll-label-actions">
                        <button type="button" class="roll-label-action roll-label-action--blind" data-action="rollWeaponDamage" data-roll-mode="blind" title="{{localize "STARFRONTIERS.Weapon.RollDamageBlind"}}"></button>
                        <button type="button" class="roll-label-action roll-label-action--gm" data-action="rollWeaponDamage" data-roll-mode="gm" title="{{localize "STARFRONTIERS.Weapon.RollDamageWhisper"}}"></button>
                      </div>
                    </div>
                  {{else}}
                    <span class="creature-attack-button creature-attack-button--damage creature-attack-button--empty">{{wpn.damage}}</span>
                  {{/if}}
                </div>
                <span class="creature-attack-row__defense">{{wpn.defenseLabel}}</span>
                <div class="creature-attack-row__actions">
                  <button type="button" data-action="openItem" title="{{localize "STARFRONTIERS.Item.Open"}}">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>
                  <button type="button" data-action="deleteItem" title="{{localize "STARFRONTIERS.Item.Delete"}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              </div>
            {{/each}}
          </div>
        </div>
      {{/if}}
    </fieldset>

    <fieldset class="paper-box full-width">
      <legend>{{localize "STARFRONTIERS.Creature.Special"}}</legend>
      <div class="creature-specials">
        <div class="creature-special-block">
          <div class="creature-subsection__header">
            <h3>{{localize "STARFRONTIERS.Creature.SpecialAttacks"}}</h3>
            <button type="button" data-action="addSpecialAttack">
              <i class="fa-solid fa-plus"></i>
              <span>{{localize "STARFRONTIERS.Creature.AddSpecialAttack"}}</span>
            </button>
          </div>
          {{#if specialAttackRows.length}}
            <div class="creature-special-attack-list">
              {{#each specialAttackRows as |entry|}}
                <div class="creature-special-attack-row">
                  <div class="creature-special-attack-row__body">
                    <label class="field-line">
                      <span>{{localize "STARFRONTIERS.Creature.SpecialAttackLabel"}}</span>
                      <input type="text" name="system.specialAttacks.{{entry.index}}.label" value="{{entry.label}}" />
                    </label>
                    <div class="stacked">
                      <span>{{localize "STARFRONTIERS.Creature.SpecialAttackDetail"}}</span>
                      <prose-mirror
                        name="system.specialAttacks.{{entry.index}}.detail"
                        data-document-u-u-i-d="{{@root.actor.uuid}}"
                        value="{{entry.detail}}"
                        collaborate="false"
                        toggled="true"
                      >
                        {{{entry.enrichedDetail}}}
                      </prose-mirror>
                    </div>
                  </div>
                  <button
                    type="button"
                    class="creature-row-remove"
                    data-action="removeSpecialAttack"
                    data-index="{{entry.index}}"
                    title="{{localize "STARFRONTIERS.Item.Delete"}}"
                  >
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Creature.NoSpecialAttacks"}}</p>
          {{/if}}
        </div>

        <div class="creature-special-block">
          <div class="creature-subsection__header">
            <h3>{{localize "STARFRONTIERS.Creature.SpecialDefenses"}}</h3>
          </div>
          <div class="creature-line creature-line--defense-selects">
            <label class="stacked creature-multi-field">
              <span>{{localize "STARFRONTIERS.Creature.Immunities"}}</span>
              <select class="multiSelect" name="system.defense.immunities" multiple size="6">
                {{selectOptions specialDefenseChoices selected=system.defense.immunities}}
              </select>
            </label>
            <label class="stacked creature-multi-field">
              <span>{{localize "STARFRONTIERS.Creature.Halves"}}</span>
              <select class="multiSelect" name="system.defense.halves" multiple size="6">
                {{selectOptions specialDefenseChoices selected=system.defense.halves}}
              </select>
            </label>
          </div>
          <div class="creature-line creature-line--defense-stats">
            <label class="inline-field">
              <span>{{localize "STARFRONTIERS.Creature.ArmorPoints"}}</span>
              <input type="number" name="system.defense.armorPoints" value="{{system.defense.armorPoints}}" min="0" />
            </label>
            <label class="inline-field">
              <span>{{localize "STARFRONTIERS.Creature.Regenerate"}}</span>
              <input type="number" name="system.defense.regenerate" value="{{system.defense.regenerate}}" min="0" />
            </label>
            <label class="inline-field">
              <span>{{localize "STARFRONTIERS.Creature.SizeToHitMod"}}</span>
              <input type="number" name="system.defense.sizeToHitMod" value="{{system.defense.sizeToHitMod}}" />
            </label>
          </div>
          <div class="stacked">
            <span>{{localize "STARFRONTIERS.Creature.DefenseNotes"}}</span>
            <prose-mirror
              name="system.defense.notes"
              data-document-u-u-i-d="{{actor.uuid}}"
              value="{{system.defense.notes}}"
              collaborate="false"
              toggled="true"
            >
              {{{enrichedDefenseNotes}}}
            </prose-mirror>
          </div>
        </div>
      </div>
    </fieldset>

    <fieldset class="paper-box full-width">
      <legend>{{localize "STARFRONTIERS.Creature.Description"}}</legend>
      <prose-mirror
        name="system.description"
        data-document-u-u-i-d="{{actor.uuid}}"
        value="{{system.description}}"
        collaborate="false"
        toggled="true"
      >
        {{{enrichedDescription}}}
      </prose-mirror>
    </fieldset>

    <fieldset class="paper-box full-width">
      <legend>{{localize "STARFRONTIERS.Creature.GMNotes"}}</legend>
      <prose-mirror
        name="system.gmNotes"
        data-document-u-u-i-d="{{actor.uuid}}"
        value="{{system.gmNotes}}"
        collaborate="false"
        toggled="true"
      >
        {{{enrichedGmNotes}}}
      </prose-mirror>
    </fieldset>
  </main>
</section>

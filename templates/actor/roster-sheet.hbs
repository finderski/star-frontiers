{{#unless isGM}}
  <section class="star-frontiers-sheet star-frontiers-roster-sheet {{themeClass}}" autocomplete="off">
    <div class="paper-box full-width roster-locked">
      <p>{{localize "STARFRONTIERS.Roster.GMOnly"}}</p>
    </div>
  </section>
{{else}}
  <section class="star-frontiers-sheet star-frontiers-roster-sheet {{themeClass}}" autocomplete="off">
    <fieldset class="paper-box full-width roster-entries">
      <legend>{{localize "STARFRONTIERS.Roster.TrackedActors"}}</legend>

      <div class="roster-drop-zone">
        {{localize "STARFRONTIERS.Roster.DropActor"}}
      </div>

      <div class="roster-toolbar">
        <button type="button" data-action="refreshRoster" title="{{localize "STARFRONTIERS.Roster.RefreshHint"}}">
          <i class="fa-solid fa-arrows-rotate"></i>
          <span>{{localize "STARFRONTIERS.Roster.Refresh"}}</span>
        </button>
        <button type="button" data-action="toggleAllRosterRows" title="{{#if anyRowExpanded}}{{localize "STARFRONTIERS.Roster.CollapseAllHint"}}{{else}}{{localize "STARFRONTIERS.Roster.ExpandAllHint"}}{{/if}}">
          <i class="fa-solid {{#if anyRowExpanded}}fa-angles-up{{else}}fa-angles-down{{/if}}"></i>
          <span>{{#if anyRowExpanded}}{{localize "STARFRONTIERS.Roster.CollapseAll"}}{{else}}{{localize "STARFRONTIERS.Roster.ExpandAll"}}{{/if}}</span>
        </button>
      </div>

      {{#if entryRows.length}}
        <div class="roster-list">
          {{#each entryRows as |row|}}
            <div class="roster-row-wrapper {{#if row.missing}}roster-row-wrapper--missing{{/if}}" data-entry-key="{{row.entryKey}}">
              <span class="drag-handle roster-row__drag-handle" draggable="true" data-drag="roster-reorder" title="{{localize "STARFRONTIERS.Common.DragToReorder"}}">
                <i class="fa-solid fa-grip-vertical"></i>
              </span>
              <article class="roster-row {{#if row.missing}}roster-row--missing{{/if}} {{#if row.isExpanded}}roster-row--expanded{{/if}}" data-index="{{row.index}}" data-entry-key="{{row.entryKey}}">
                <div class="roster-row__portrait">
                  {{#if row.img}}
                    <img src="{{row.img}}" alt="" />
                  {{else}}
                    <div class="roster-row__portrait-fallback">{{localize "STARFRONTIERS.Roster.MissingActor"}}</div>
                  {{/if}}
                </div>

                <div class="roster-row__body">
                  <div class="roster-row__header">
                    <div class="roster-row__identity">
                      <div class="roster-row__name">
                        <span>{{row.name}}</span>
                        {{#if row.headlineValue}}
                          <span>&bull;</span>
                          <span>{{row.headlineLabel}}: {{row.headlineValue}}</span>
                        {{/if}}
                        {{#if row.hasEffects}}
                          <span>&bull;</span>
                          <div class="roster-row__effect-icons">
                            {{#each row.effects as |effect|}}
                              <img class="roster-row__effect-icon" src="{{effect.img}}" alt="{{effect.name}}" title="{{#if effect.sourceName}}{{effect.name}} ({{effect.sourceName}}){{else}}{{effect.name}}{{/if}}" />
                            {{/each}}
                          </div>
                        {{/if}}
                      </div>
                      {{#if row.isExpanded}}
                        <div class="roster-row__meta">
                          <span>{{row.typeLabel}}</span>
                          {{#if row.role}}
                            <span>&bull;</span>
                            <span>{{row.role}}</span>
                          {{/if}}
                        </div>

                        {{#if row.summary}}
                          <div class="roster-row__summary">{{row.summary}}</div>
                        {{/if}}
                      {{/if}}
                    </div>
                    <div class="roster-row__actions">
                      <button type="button" data-action="toggleRosterEntry" title="{{#if row.isExpanded}}{{localize "STARFRONTIERS.Roster.Collapse"}}{{else}}{{localize "STARFRONTIERS.Item.Expand"}}{{/if}}">
                        <i class="fa-solid {{#if row.isExpanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
                      </button>
                      {{#unless row.missing}}
                        <button type="button" data-action="openTrackedActor" title="{{localize "STARFRONTIERS.Roster.OpenActor"}}">
                          <i class="fa-solid fa-up-right-from-square"></i>
                        </button>
                      {{/unless}}
                      <button type="button" data-action="removeRosterEntry" title="{{localize "STARFRONTIERS.Roster.RemoveActor"}}">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </div>
                  </div>

                  {{#if row.isExpanded}}
                    <div class="roster-row__expanded">
                  {{else}}
                    <div class="roster-row__collapsed">
                  {{/if}}
                    {{#if row.stats.length}}
                      <div class="roster-row__stats">
                        {{#each row.stats as |stat|}}
                          <span class="roster-row__stat">
                            <strong>{{stat.label}}:</strong>
                            <span>{{stat.value}}</span>
                          </span>
                          {{#unless @last}}&bull;{{/unless}}
                        {{/each}}
                      </div>
                    {{/if}}

                    <div class="roster-row__collapsed-actions">
                      <button type="button" class="roster-row__notes-toggle" data-action="toggleRosterNotes">
                        {{#if row.notesOpen}}{{localize "STARFRONTIERS.Roster.HideNotes"}}{{else}}{{localize "STARFRONTIERS.Roster.Notes"}}{{/if}}
                      </button>
                    </div>
                  </div>

                  {{#if row.isExpanded}}
                    <div class="roster-row__details">
                      {{#if row.missing}}
                        <div class="roster-row__uuid">{{row.actorUuid}}</div>
                      {{/if}}

                      {{#if row.defensesLabel}}
                        <div class="roster-row__line">
                          <strong>{{localize "STARFRONTIERS.Roster.Defenses"}}:</strong>
                          <span>{{row.defensesLabel}}</span>
                        </div>
                      {{/if}}
                    </div>
                  {{/if}}

                  {{#if row.notesOpen}}
                    <div class="roster-row__notes-block">
                      <label class="stacked roster-row__notes">
                        <textarea name="system.entries.{{row.index}}.notes" placeholder="{{localize "STARFRONTIERS.Roster.NotesPlaceholder"}}">{{row.notes}}</textarea>
                      </label>
                    </div>
                  {{/if}}

                  <input type="hidden" name="system.entries.{{row.index}}.actorUuid" value="{{row.actorUuid}}" />
                  <input type="hidden" name="system.entries.{{row.index}}.sort" value="{{row.sort}}" />
                  <input type="hidden" name="system.entries.{{row.index}}.pinned" value="{{row.pinned}}" />
                </div>
              </article>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Roster.Empty"}}</p>
      {{/if}}
    </fieldset>
  </section>
{{/unless}}

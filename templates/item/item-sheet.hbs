<section class="star-frontiers-item-sheet {{themeClass}}" data-rules-edition="{{rulesEdition}}" autocomplete="off">
  <header class="item-header">
    <div class="item-image" data-action="editImage" title="{{localize "STARFRONTIERS.Item.ChangeIcon"}}">
      {{#if imageUsesMask}}
        <div class="item-image__icon" style="--item-img: url('{{item.img}}')"></div>
      {{else}}
        <img class="item-image__art" src="{{item.img}}" alt="" />
      {{/if}}
    </div>
    <div class="item-title">
      <label class="field-line">
        <span>{{localize nameLabel}}</span>
        <input type="text" name="name" value="{{item.name}}" />
      </label>
    </div>
  </header>

  <main class="item-grid">
    <fieldset class="paper-box item-common full-width">
      <legend>{{localize "STARFRONTIERS.Item.Common"}}</legend>
      <div class="top-row">
        {{#if showCost}}
          <label><span>{{localize "STARFRONTIERS.Item.Cost"}}</span><input type="number" name="system.cost" value="{{system.cost}}" min="0" /></label>
        {{/if}}
        {{#if expandedRules}}
          {{#if showMass}}
            <label><span>{{localize "STARFRONTIERS.Item.Mass"}}</span><input type="number" name="system.mass" value="{{system.mass}}" min="0" step="0.1" /></label>
          {{/if}}
        {{/if}}
      </div>
      <div class="stacked item-description-editor">
        <span>{{localize "STARFRONTIERS.Item.Description"}}</span>
        <prose-mirror
          name="system.description"
          data-document-u-u-i-d="{{item.uuid}}"
          value="{{system.description}}"
          collaborate="false"
          toggled="true"
        >
          {{{enrichedDescription}}}
        </prose-mirror>
      </div>
    </fieldset>

    {{#if is.race}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.RaceData"}}</legend>
        <div class="compact-grid race-modifier-grid">
          <label><span>{{localize "STARFRONTIERS.Ability.Strength-abbr-Stamina-abbr"}}</span><input type="number" name="system.modifiers.str" value="{{system.modifiers.str}}" /></label>
          <label><span>{{localize "STARFRONTIERS.Ability.Dexterity-abbr-ReactionSpeed-abbr"}}</span><input type="number" name="system.modifiers.dex" value="{{system.modifiers.dex}}" /></label>
          <label><span>{{localize "STARFRONTIERS.Ability.Intuition-abbr-Logic-abbr"}}</span><input type="number" name="system.modifiers.int" value="{{system.modifiers.int}}" /></label>
          <label><span>{{localize "STARFRONTIERS.Ability.Personality-abbr-Leadership-abbr"}}</span><input type="number" name="system.modifiers.per" value="{{system.modifiers.per}}" /></label>
          <label><span>{{localize "STARFRONTIERS.Character.InitiativeModifier-abbr"}}</span><input type="number" name="system.modifiers.im" value="{{system.modifiers.im}}" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.Size"}}</span><select name="system.size">{{selectOptions choices.size selected=system.size}}</select></label>
        </div>
        <div class="compact-grid three-columns">
          <label><span>{{localize "STARFRONTIERS.Character.Walking"}}</span><input type="number" name="system.movement.walking" value="{{system.movement.walking}}" min="0" /></label>
          <label><span>{{localize "STARFRONTIERS.Character.Running"}}</span><input type="number" name="system.movement.running" value="{{system.movement.running}}" min="0" /></label>
          <label><span>{{localize "STARFRONTIERS.Character.Hourly"}}</span><input type="number" name="system.movement.hourly" value="{{system.movement.hourly}}" min="0" /></label>
        </div>

        <div class="race-editor-block">
          <div class="race-editor-block__header">
            <span>{{localize "STARFRONTIERS.Item.RacialAbilities"}}</span>
          </div>
          <div class="linked-ability-drop-zone">
            <span>{{localize "STARFRONTIERS.Item.DropRacialAbility"}}</span>
          </div>
          {{#if linkedRacialAbilities.length}}
            <div class="linked-ability-list">
              {{#each linkedRacialAbilities as |ability|}}
                <div class="linked-ability-row">
                  <div class="linked-ability-row__body">
                    <button
                      type="button"
                      class="linked-ability-row__toggle"
                      data-action="toggleLinkedRaceAbilityExpanded"
                      aria-expanded="false"
                    >{{ability.name}}</button>
                    {{#if ability.description}}
                      <div class="linked-ability-row__description">{{{ability.description}}}</div>
                    {{/if}}
                  </div>
                  <button type="button" data-action="removeLinkedRaceAbility" data-ref="{{ability.id}}" title="{{localize "STARFRONTIERS.Item.RemoveRaceAbility"}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Item.NoRaceAbilities"}}</p>
          {{/if}}
        </div>

        <div class="race-editor-block">
          <div class="race-editor-block__header">
            <span>{{localize "STARFRONTIERS.Item.BonusPicks"}}</span>
            <button type="button" data-action="addBonusPick">
              <i class="fa-solid fa-plus"></i>
              <span>{{localize "STARFRONTIERS.Item.AddBonusPick"}}</span>
            </button>
          </div>
          {{#if bonusPickRows.length}}
            <div class="race-bonus-list">
              {{#each bonusPickRows as |pick index|}}
                <div class="compact-grid four-columns race-bonus-row">
                  <label><span>{{localize "STARFRONTIERS.Item.Amount"}}</span><input type="number" name="system.bonusPicks.{{index}}.amount" value="{{pick.amount}}" /></label>
                  <label><span>{{localize "STARFRONTIERS.Item.Slots"}}</span><input type="number" name="system.bonusPicks.{{index}}.slots" value="{{pick.slots}}" min="0" /></label>
                  <label><span>{{localize "STARFRONTIERS.Item.AppliesTo"}}</span><select name="system.bonusPicks.{{index}}.appliesTo">{{selectOptions @root.choices.bonusPickAppliesTo selected=pick.appliesTo}}</select></label>
                  <div class="race-bonus-row__actions">
                    <button type="button" data-action="removeBonusPick" data-index="{{index}}" title="{{localize "STARFRONTIERS.Item.RemoveBonusPick"}}">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Item.NoBonusPicks"}}</p>
          {{/if}}
        </div>
      </fieldset>
    {{/if}}

    {{#if is.weapon}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.WeaponData"}}</legend>
        <div class="fireMode-row">
          <label class="checkbox-line">
            <input type="checkbox" name="system.mechanics.hasModes" {{checked system.mechanics.hasModes}} />
            <span>{{localize "STARFRONTIERS.Weapon.HasModes"}}</span>
          </label>
        </div>
        {{#if weaponIsMelee}}
          <div class="fireMode-row">
            <label class="checkbox-line">
              <input type="checkbox" name="system.mechanics.barehand" {{checked system.mechanics.barehand}} />
              <span>{{localize "STARFRONTIERS.Weapon.Barehand"}}</span>
            </label>
          </div>
        {{/if}}
        <div class="compact-grid weapon-core-grid">
          <label>
            <span>{{localize "STARFRONTIERS.Item.WeaponType"}}</span>
            <select name="system.weaponType">{{selectOptions choices.weaponType selected=system.weaponType}}</select>
          </label>
          <label>
            <span>{{localize "STARFRONTIERS.Item.AttributeKey"}}</span>
            <select name="system.attributeKey">{{selectOptions choices.attributeKey selected=system.attributeKey}}</select>
          </label>
          {{#unless system.mechanics.hasModes}}
            <label>
              <span>{{localize "STARFRONTIERS.Item.DamageFormula"}}</span>
              <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" />
            </label>
            <label>
              <span>{{localize "STARFRONTIERS.Item.Defense"}}</span>
              <select name="system.damageType">{{selectOptions choices.damageType selected=system.damageType}}</select>
            </label>
            <label>
              <span>{{localize "STARFRONTIERS.Weapon.AttackModifier"}}</span>
              <input type="number" name="system.mechanics.attackModifier" value="{{system.mechanics.attackModifier}}" step="1" />
            </label>
          {{/unless}}
        </div>
        {{#if hasVariableSeuDial}}
          {{#unless system.mechanics.hasModes}}
          <p class="form-hint">{{localize "STARFRONTIERS.Item.WeaponDamageFormulaSeuHint"}}</p>
          {{/unless}}
        {{/if}}

        <div class="range-editor">
          <span></span>
          <span>{{localize "STARFRONTIERS.Item.RangeMin"}}</span>
          <span>{{localize "STARFRONTIERS.Item.RangeMax"}}</span>
          <span>{{localize "STARFRONTIERS.Item.RangeDamage"}}</span>
          {{#each rangeRows as |row|}}
            <span>{{row.label}}</span>
            {{#if @root.weaponIsMelee}}
              <input type="number" name="system.rangeBands.{{row.key}}.min" value="0" readonly />
              <input type="number" name="system.rangeBands.{{row.key}}.max" value="2" readonly />
            {{else}}
              <input type="number" name="system.rangeBands.{{row.key}}.min" value="{{row.band.min}}" min="0" />
              <input type="number" name="system.rangeBands.{{row.key}}.max" value="{{row.band.max}}" min="0" />
            {{/if}}
            <input type="text" name="system.rangeBands.{{row.key}}.damageFormula" value="{{row.band.damageFormula}}" placeholder="—" />
          {{/each}}
        </div>

        <div class="ammo-drop-zone">
          <span>{{localize "STARFRONTIERS.Item.RequiredSkill"}}</span>
          <div>
            {{#if linkedRequiredSkill}}
              <strong>{{linkedRequiredSkill.name}}</strong>
              <button type="button" data-action="clearRequiredSkill" title="{{localize "STARFRONTIERS.Item.ClearSkill"}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            {{else}}
              <span>{{localize "STARFRONTIERS.Item.DropSkill"}}</span>
            {{/if}}
          </div>
        </div>

        <div class="ammo-drop-zone">
          <span>{{localize "STARFRONTIERS.Item.LinkedAmmo"}}</span>
          <div>
            {{#if linkedAmmo}}
              <strong>{{linkedAmmo.name}}</strong>
              <button type="button" data-action="clearAmmo" title="{{localize "STARFRONTIERS.Item.ClearAmmo"}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            {{else}}
              <span>{{localize "STARFRONTIERS.Item.DropAmmo"}}</span>
            {{/if}}
          </div>
        </div>

        <div class="compact-grid three-columns">
          <label>
            <span>{{localize "STARFRONTIERS.Item.AmmoUse"}}</span>
            <select name="system.ammo.uses">{{selectOptions choices.ammoUse selected=system.ammo.uses}}</select>
          </label>
          {{#if weaponUsesAmmo}}
            <label><span>{{localize weaponAmmoPerShotLabel}}</span><input type="number" name="system.ammo.seuPerShot" value="{{system.ammo.seuPerShot}}" min="0" /></label>
          {{/if}}
          <label class="checkbox-line"><span>{{localize "STARFRONTIERS.Item.HeavyWeapon"}}</span><input type="checkbox" name="system.mechanics.isHeavy" {{checked system.mechanics.isHeavy}} /></label>
          {{#if expandedRules}}
            <label><span>{{localize "STARFRONTIERS.Item.RateOfFire"}}</span><input type="number" name="system.mechanics.rateOfFire" value="{{system.mechanics.rateOfFire}}" min="1" /></label>
            {{#if weaponUsesSeu}}
              <label><span>{{localize "STARFRONTIERS.Item.VariableMin"}}</span><input type="number" name="system.ammo.variableSetting.min" value="{{system.ammo.variableSetting.min}}" min="0" /></label>
              <label><span>{{localize "STARFRONTIERS.Item.VariableMax"}}</span><input type="number" name="system.ammo.variableSetting.max" value="{{system.ammo.variableSetting.max}}" min="0" /></label>
            {{/if}}
          {{/if}}
        </div>
        <!--
        <div class="compact-grid two-columns">
          <label class="checkbox-line">
            <span>{{localize "STARFRONTIERS.Weapon.HasModes"}}</span>
            <input type="checkbox" name="system.mechanics.hasModes" {{checked system.mechanics.hasModes}} />
          </label>
        </div>
        -->

        {{#if system.mechanics.hasModes}}
          <fieldset class="paper-box full-width weapon-modes-editor">
            <legend>{{localize "STARFRONTIERS.Weapon.Modes"}}</legend>
            <p class="weapon-modes-editor__hint">{{localize "STARFRONTIERS.Weapon.ModesHint"}}</p>

            {{#if weaponModeRows.length}}
              <div class="weapon-mode-list">
                {{#each weaponModeRows as |mode|}}
                  <div class="weapon-mode-row">
                    <div class="weapon-mode-row__header">
                      <span class="weapon-mode-row__title">{{localize "STARFRONTIERS.Weapon.Mode.Label"}} {{mode.displayIndex}}</span>
                      <button
                        type="button"
                        data-action="removeWeaponMode"
                        data-index="{{mode.index}}"
                        title="{{localize "STARFRONTIERS.Weapon.RemoveMode"}}"
                      >
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </div>

                    <div class="compact-grid two-columns">
                      <label>
                        <span>{{localize "STARFRONTIERS.Weapon.ModeKey"}}</span>
                        <input type="text" name="system.mechanics.modes.{{mode.index}}.key" value="{{mode.key}}" placeholder="stun" />
                      </label>
                      <label>
                        <span>{{localize "STARFRONTIERS.Weapon.ModeLabel"}}</span>
                        <input type="text" name="system.mechanics.modes.{{mode.index}}.label" value="{{mode.label}}" placeholder="Stun" />
                      </label>
                    </div>

                    <div class="compact-grid four-columns">
                      <label>
                        <span>{{localize "STARFRONTIERS.Weapon.ModeDamage"}}</span>
                        <input type="text" name="system.mechanics.modes.{{mode.index}}.damageFormula" value="{{mode.damageFormula}}" placeholder="4d10" />
                      </label>
                      <label>
                        <span>{{localize "STARFRONTIERS.Weapon.AttackModifier"}}</span>
                        <input type="number" name="system.mechanics.modes.{{mode.index}}.attackModifier" value="{{mode.attackModifier}}" step="1" />
                      </label>
                      <label>
                        <span>{{localize @root.weaponModeAmmoPerShotLabel}}</span>
                        <input type="number" name="system.mechanics.modes.{{mode.index}}.seuPerShot" value="{{mode.seuPerShot}}" min="0" />
                      </label>
                      <label>
                        <span>{{localize "STARFRONTIERS.Weapon.ModeDefenseTypes"}}</span>
                        <select class="multiSelect" name="system.mechanics.modes.{{mode.index}}.defenseTypes" multiple size="4">
                          {{selectOptions @root.modeDefenseTypeChoices selected=mode.defenseTypes}}
                        </select>
                      </label>
                    </div>

                    <fieldset class="paper-box">
                      <legend>{{localize "STARFRONTIERS.Weapon.ModeAvoidance"}}</legend>
                      <div class="compact-grid two-columns">
                        <label class="checkbox-line">
                          <span>{{localize "STARFRONTIERS.Weapon.AvoidanceEnabled"}}</span>
                          <input type="checkbox" name="system.mechanics.modes.{{mode.index}}.avoidance.enabled" {{checked mode.avoidance.enabled}} />
                        </label>
                        <label>
                          <span>{{localize "STARFRONTIERS.Weapon.AvoidanceAbility"}}</span>
                          <select name="system.mechanics.modes.{{mode.index}}.avoidance.ability">
                            {{selectOptions @root.avoidanceAbilityChoices selected=mode.avoidance.ability}}
                          </select>
                        </label>
                      </div>
                      <div class="compact-grid two-columns">
                        <label>
                          <span>{{localize "STARFRONTIERS.Weapon.AvoidanceOnSuccessEffect"}}</span>
                          <input type="text" name="system.mechanics.modes.{{mode.index}}.avoidance.onSuccessEffect" value="{{mode.avoidance.onSuccessEffect}}" placeholder="Knocked unconscious" />
                        </label>
                        <label>
                          <span>{{localize "STARFRONTIERS.Weapon.AvoidanceFailNote"}}</span>
                          <input type="text" name="system.mechanics.modes.{{mode.index}}.avoidance.failNote" value="{{mode.avoidance.failNote}}" placeholder="Target is knocked unconscious." />
                        </label>
                      </div>
                    </fieldset>

                    <div class="weapon-mode-row__effects">
                      <div class="weapon-mode-row__effects-header">
                        <span class="weapon-mode-row__effects-title">{{localize "STARFRONTIERS.Weapon.ModeOnHitEffects"}}</span>
                        <button type="button" data-action="addWeaponModeEffect" data-mode-index="{{mode.index}}">
                          <i class="fa-solid fa-plus"></i>
                          <span>{{localize "STARFRONTIERS.Item.AddEffect"}}</span>
                        </button>
                      </div>
                      {{#if mode.onHitEffectRows.length}}
                        <div class="linked-ability-list" data-mode-index="{{mode.index}}">
                          {{#each mode.onHitEffectRows as |effectRow|}}
                            <div class="linked-ability-row">
                              <div class="linked-ability-row__body">
                                <button
                                  type="button"
                                  class="linked-ability-row__toggle"
                                  data-action="openEffect"
                                  data-effect-id="{{effectRow.effectId}}"
                                  data-effect-ref="{{effectRow.id}}"
                                >{{effectRow.name}}</button>
                                {{#if effectRow.sourceName}}
                                  <span class="linked-ability-row__meta">{{effectRow.sourceName}}</span>
                                {{/if}}
                              </div>
                              <button
                                type="button"
                                data-action="removeWeaponModeEffect"
                                data-mode-index="{{mode.index}}"
                                data-effect-id="{{effectRow.id}}"
                                title="{{localize "STARFRONTIERS.Weapon.RemoveOnHitEffect"}}"
                              >
                                <i class="fa-solid fa-trash"></i>
                              </button>
                            </div>
                          {{/each}}
                        </div>
                      {{else}}
                        <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Weapon.NoOnHitEffects"}}</p>
                      {{/if}}
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Weapon.NoModes"}}</p>
            {{/if}}

            <button type="button" data-action="addWeaponMode">
              <i class="fa-solid fa-plus"></i>
              <span>{{localize "STARFRONTIERS.Weapon.AddMode"}}</span>
            </button>
          </fieldset>
        {{/if}}
      </fieldset>
    {{/if}}

    {{#if is.skill}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.SkillData"}}</legend>
        <div class="compact-grid four-columns">
          <label><span>{{localize "STARFRONTIERS.Item.PSA"}}</span><select name="system.psa">{{selectOptions choices.psa selected=system.psa}}</select></label>
          <label><span>{{localize "STARFRONTIERS.Item.Category"}}</span><select name="system.category">{{selectOptions choices.skillCategory selected=system.category}}</select></label>
          <label><span>{{localize "STARFRONTIERS.Item.AttributeKey"}}</span><select name="system.attributeKey">{{selectOptions choices.attributeKey selected=system.attributeKey}}</select></label>
          <label><span>{{localize "STARFRONTIERS.Item.RollFormula"}}</span><input type="text" name="system.rollFormula" value="{{system.rollFormula}}" placeholder="ceil(@dex*.5) + @level" /></label>
        </div>

        {{#if isMilitarySkill}}
          <div class="skill-combat-bonus-row">
            <label class="checkbox-line"><span>{{localize "STARFRONTIERS.Item.ApplyMeleeBonus"}}</span><input type="checkbox" name="system.mechanics.applyMeleeBonus" {{checked system.mechanics.applyMeleeBonus}} /></label>
            <label class="checkbox-line"><span>{{localize "STARFRONTIERS.Item.ApplyRangeBonus"}}</span><input type="checkbox" name="system.mechanics.applyRangeBonus" {{checked system.mechanics.applyRangeBonus}} /></label>
          </div>
        {{/if}}

        {{#if skillIsMain}}
          <div class="race-editor-block">
            <div class="race-editor-block__header">
              <span>{{localize "STARFRONTIERS.Item.SubSkills"}}</span>
            </div>
            <div class="linked-ability-drop-zone">
              <span>{{localize "STARFRONTIERS.Item.DropSubSkill"}}</span>
            </div>
            {{#if linkedSubskills.length}}
              <div class="linked-ability-list">
                {{#each linkedSubskills as |sub|}}
                  <div class="linked-ability-row">
                    <div class="linked-ability-row__body">
                      <strong>{{sub.name}}</strong>
                    </div>
                    <button type="button" data-action="removeSubskill" data-ref="{{sub.id}}">
                      <i class="fa-solid fa-trash"></i>
                      <span>{{localize "STARFRONTIERS.Item.RemoveSubSkill"}}</span>
                    </button>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Item.NoSubSkills"}}</p>
            {{/if}}
          </div>
        {{/if}}
      </fieldset>
    {{/if}}

    {{#if is.trainedAbility}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.TrainedAbilityData"}}</legend>
        <div class="compact-grid four-columns">
          <label><span>{{localize "STARFRONTIERS.Item.RollType"}}</span><select name="system.rollType">{{selectOptions choices.rollType selected=system.rollType}}</select></label>
          <label><span>{{localize "STARFRONTIERS.Item.BaseChance"}}</span><input type="number" name="system.baseChance" value="{{system.baseChance}}" min="0" max="100" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.Cap"}}</span><input type="number" name="system.cap" value="{{system.cap}}" min="0" max="100" /></label>
          <label class="hasHint">
            <span>{{localize "STARFRONTIERS.Item.XPPerPoint"}}</span>
            <input type="number" name="system.xpPerPoint" value="{{system.xpPerPoint}}" min="0" />
            <small class="form-hint">{{localize "STARFRONTIERS.Item.XPPerPointHint"}}</small>
          </label>
          {{#if homebrewAdvancementEnabled}}
            <label class="hasHint">
              <span>{{localize "STARFRONTIERS.Item.AdvancementCost"}}</span>
              <input type="number" name="system.advancementCost" value="{{system.advancementCost}}" min="0" />
              <small class="form-hint">{{localize "STARFRONTIERS.Item.AdvancementCostHint"}}</small>
            </label>
          {{/if}}
        </div>

        <div class="race-editor-block">
          <div class="race-editor-block__header">
            <span>{{localize "STARFRONTIERS.Item.Effects"}}</span>
            <button type="button" data-action="addEffect">
              <i class="fa-solid fa-plus"></i>
              <span>{{localize "STARFRONTIERS.Item.AddEffect"}}</span>
            </button>
          </div>
          {{#if itemEffects.length}}
            <div class="effect-list">
              {{#each itemEffects as |effect|}}
                <div class="effect-row">
                  <button type="button" class="effect-row__open" data-action="openEffect" data-effect-id="{{effect.id}}">
                    <img class="effect-row__icon" src="{{effect.img}}" alt="" />
                    <span class="effect-row__name">{{effect.name}}</span>
                  </button>
                  <div class="effect-row__badges">
                    {{#if effect.transfer}}<span class="effect-row__badge" title="{{localize "STARFRONTIERS.Item.EffectTransfers"}}"><i class="fa-solid fa-arrow-up-from-bracket"></i></span>{{/if}}
                    {{#if effect.disabled}}<span class="effect-row__badge effect-row__badge--off" title="{{localize "STARFRONTIERS.Item.EffectDisabled"}}"><i class="fa-solid fa-ban"></i></span>{{/if}}
                  </div>
                  <button type="button" class="effect-row__delete" data-action="deleteEffect" data-effect-id="{{effect.id}}" title="{{localize "STARFRONTIERS.Item.DeleteEffect"}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Item.NoEffects"}}</p>
          {{/if}}
        </div>
      </fieldset>
    {{/if}}

    {{#if is.armor}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.ArmorData"}}</legend>
        <div class="item-inline-row">
          <!-- 
          <label class="item-inline-field item-inline-field--grow">
            <span>{{localize "STARFRONTIERS.Item.ArmorType"}}</span>
            <input
              type="text"
              name="system.armorType"
              value="{{system.armorType}}"
              placeholder="{{localize "STARFRONTIERS.Item.ArmorTypePlaceholder"}}"
            />
          </label>
          -->
          <label class="armor-inline-field">
            <span>{{localize "STARFRONTIERS.Item.MaxAbsorbed"}}</span>
            <i class="fa-solid fa-circle-info" data-tooltip="{{localize "STARFRONTIERS.Item.MaxAbsorbedHint"}}"></i>
            <input
              class="twelve-character-wide"
              type="number"
              name="system.maxAbsorbed"
              value="{{system.maxAbsorbed}}"
              min="0"
              step="1"
              placeholder="{{localize "STARFRONTIERS.Item.MaxAbsorbedNullPlaceholder"}}"
            />
            <!--<small class="form-hint">{{localize "STARFRONTIERS.Item.MaxAbsorbedHint"}}</small>-->
          </label>
          <label class="armor-inline-field item-inline-field--readout">
            <span>{{localize "STARFRONTIERS.Item.Absorbed"}}</span>
            <span class="item-readout">
              {{#if armorHasThreshold}}
                {{system.accumulatedDamage}} / {{system.maxAbsorbed}}
              {{else}}
                {{system.accumulatedDamage}}
              {{/if}}
            </span>
          </label>
        </div>

        <div class="item-inline-row">
          <label class="armor-inline-field">
            <span>{{localize "STARFRONTIERS.Item.ApplyPreset"}}</span>
            <i class="fa-solid fa-circle-info" data-tooltip="{{localize "STARFRONTIERS.Item.PresetHint"}}"></i>
            <select data-action="applyArmorPreset">
              <option value="">{{localize "STARFRONTIERS.Item.PresetSelect"}}</option>
              {{selectOptions armorPresetChoices}}
            </select>
            <!--<small class="form-hint">{{localize "STARFRONTIERS.Item.PresetHint"}}</small>-->
          </label>
        </div>

        {{> "systems/star-frontiers/templates/item/parts/reductions-editor.hbs"}}
      </fieldset>
    {{/if}}

    {{#if is.screen}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.ScreenData"}}</legend>
        <div class="item-inline-row">
          <label class="item-inline-field item-inline-field--grow">
            <span>{{localize "STARFRONTIERS.Item.ScreenType"}}</span>
            <select name="system.screenType">{{selectOptions choices.screenType selected=system.screenType}}</select>
          </label>
          <label class="item-inline-field">
            <span>{{localize "STARFRONTIERS.Item.Capacity"}}</span>
            <input type="number" name="system.capacity" value="{{system.capacity}}" min="0" />
          </label>
          <label class="item-inline-field">
            <span>{{localize "STARFRONTIERS.Item.SEUPerHit"}}</span>
            <input type="number" name="system.seuPerHit" value="{{system.seuPerHit}}" min="0" />
          </label>
          <label class="item-inline-field checkbox-line">
            <span>{{localize "STARFRONTIERS.Item.Active"}}</span>
            <input type="checkbox" name="system.active" {{checked system.active}} />
          </label>
        </div>

        <div class="item-inline-row">
          <label class="item-inline-field">
            <span>{{localize "STARFRONTIERS.Item.ApplyPreset"}}</span>
            <select data-action="applyScreenPreset">
              <option value="">{{localize "STARFRONTIERS.Item.PresetSelect"}}</option>
              {{selectOptions screenPresetChoices}}
            </select>
            <small class="form-hint">{{localize "STARFRONTIERS.Item.PresetHint"}}</small>
          </label>
        </div>

        {{> "systems/star-frontiers/templates/item/parts/reductions-editor.hbs"}}

        <div class="ammo-drop-zone" data-drop-type="powerSource">
          <span>{{localize "STARFRONTIERS.Item.PowerSource"}}</span>
          <div>
            {{#if linkedScreenPowerSource}}
              <strong>{{linkedScreenPowerSource.name}}</strong>
              <span class="linked-ability-row__meta">{{linkedScreenPowerSource.remaining}}/{{linkedScreenPowerSource.capacity}} SEU</span>
              <button type="button" data-action="clearScreenPowerSource" title="{{localize "STARFRONTIERS.Item.ClearPowerSource"}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            {{else}}
              <span>{{localize "STARFRONTIERS.Item.DropPowerSource"}}</span>
            {{/if}}
          </div>
        </div>
      </fieldset>
    {{/if}}

    {{#if is.ammo}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.AmmoData"}}</legend>
        <div class="compact-grid auto-columns">
          <label><span>{{localize "STARFRONTIERS.Item.AmmoType"}}</span><select name="system.ammoType">{{selectOptions choices.ammoType selected=system.ammoType}}</select></label>
          <label><span>{{localize "STARFRONTIERS.Item.Shots"}}</span><input type="number" name="system.shots" value="{{system.shots}}" min="0" /></label>
        </div>
      </fieldset>
    {{/if}}

    {{#if is.powerSource}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.PowerSourceData"}}</legend>
        <div class="compact-grid four-columns">
          <label><span>{{localize "STARFRONTIERS.Item.SourceType"}}</span><select name="system.sourceType">{{selectOptions choices.sourceType selected=system.sourceType}}</select></label>
          <label><span>{{localize "STARFRONTIERS.Item.Capacity"}}</span><input type="number" name="system.capacity" value="{{system.capacity}}" min="0" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.Remaining"}}</span><input type="number" name="system.remaining" value="{{system.remaining}}" min="0" /></label>
          <label class="checkbox-line"><span>{{localize "STARFRONTIERS.Item.Rechargeable"}}</span><input type="checkbox" name="system.rechargeable" {{checked system.rechargeable}} /></label>
        </div>
        <fieldset class="paper-box full-width">
          <legend>{{localize "STARFRONTIERS.Item.Ports"}}</legend>
          <div class="compact-grid three-columns">
            <label>
              <span>{{localize "STARFRONTIERS.Item.WeaponPorts"}}</span>
              <input type="number" name="system.ports.weapon" value="{{system.ports.weapon}}" min="0" step="1" />
            </label>
            <label>
              <span>{{localize "STARFRONTIERS.Item.ScreenPorts"}}</span>
              <input type="number" name="system.ports.screen" value="{{system.ports.screen}}" min="0" step="1" />
            </label>
            <label>
              <span>{{localize "STARFRONTIERS.Item.VehiclePorts"}}</span>
              <input type="number" name="system.ports.vehicle" value="{{system.ports.vehicle}}" min="0" step="1" />
            </label>
          </div>
          <p class="form-hint">{{localize "STARFRONTIERS.Item.PortsHint"}}</p>
        </fieldset>
        {{#if (gt system.ports.weapon 0)}}
        <div class="race-editor-block">
          <div class="race-editor-block__header">
            <span>{{localize "STARFRONTIERS.Item.LinkedWeapons"}}</span>
            <span class="race-editor-block__meta">{{linkedPowerSourceWeapons.length}} / {{system.ports.weapon}}</span>
          </div>
          <div class="linked-ability-drop-zone" data-drop-type="weapon">
            <span>{{localize "STARFRONTIERS.Item.DropWeapon"}}</span>
          </div>
          {{#if linkedPowerSourceWeapons.length}}
            <div class="linked-ability-list">
              {{#each linkedPowerSourceWeapons as |weapon|}}
                <div class="linked-ability-row">
                  <div class="linked-ability-row__body">
                    <strong>{{weapon.name}}</strong>
                  </div>
                  <button type="button" data-action="unlinkPowerSourceWeapon" data-ref="{{weapon.id}}" title="{{localize "STARFRONTIERS.Item.UnlinkWeapon"}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              {{/each}}
            </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if (gt system.ports.screen 0)}}
        <div class="race-editor-block">
          <div class="race-editor-block__header">
            <span>{{localize "STARFRONTIERS.Item.LinkedScreens"}}</span>
            <span class="race-editor-block__meta">{{linkedPowerSourceScreens.length}} / {{system.ports.screen}}</span>
          </div>
          <div class="linked-ability-drop-zone" data-drop-type="screen">
            <span>{{localize "STARFRONTIERS.Item.DropScreen"}}</span>
          </div>
          {{#if linkedPowerSourceScreens.length}}
            <div class="linked-ability-list">
              {{#each linkedPowerSourceScreens as |screen|}}
                <div class="linked-ability-row">
                  <div class="linked-ability-row__body">
                    <strong>{{screen.name}}</strong>
                  </div>
                  <button type="button" data-action="unlinkPowerSourceScreen" data-ref="{{screen.id}}" title="{{localize "STARFRONTIERS.Item.UnlinkScreen"}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              {{/each}}
            </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if (gt system.ports.vehicle 0)}}
        <div class="race-editor-block">
          <div class="race-editor-block__header">
            <span>{{localize "STARFRONTIERS.Item.LinkedVehicles"}}</span>
            <span class="race-editor-block__meta">{{linkedPowerSourceVehicles.length}} / {{system.ports.vehicle}}</span>
          </div>
          <div class="linked-ability-drop-zone" data-drop-type="vehicle">
            <span>{{localize "STARFRONTIERS.Item.DropVehicle"}}</span>
          </div>
          {{#if linkedPowerSourceVehicles.length}}
            <div class="linked-ability-list">
              {{#each linkedPowerSourceVehicles as |vehicle|}}
                <div class="linked-ability-row">
                  <div class="linked-ability-row__body">
                    <strong>{{vehicle.name}}</strong>
                  </div>
                  <button type="button" data-action="unlinkPowerSourceVehicle" data-ref="{{vehicle.id}}" title="{{localize "STARFRONTIERS.Item.UnlinkVehicle"}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              {{/each}}
            </div>
          {{/if}}
        </div>
        {{/if}}
      </fieldset>
    {{/if}}

    {{#if is.gear}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.GearData"}}</legend>
        <div class="compact-grid two-columns">
          <label class="checkbox-line">
            <span>{{localize "STARFRONTIERS.Item.Kit"}}</span>
            <input type="checkbox" name="system.isKit" {{checked system.isKit}} />
          </label>
        </div>
        <div class="ammo-drop-zone">
          <span>{{localize "STARFRONTIERS.Item.RequiredSkill"}}</span>
          <div>
            {{#if linkedRequiredSkill}}
              <strong>{{linkedRequiredSkill.name}}</strong>
              <button type="button" data-action="clearGearRequiredSkill" title="{{localize "STARFRONTIERS.Item.ClearSkill"}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            {{else}}
              <span>{{localize "STARFRONTIERS.Item.DropSkill"}}</span>
            {{/if}}
          </div>
        </div>
        {{#if system.isKit}}
          <div class="race-editor-block">
            <div class="race-editor-block__header">
              <span>{{localize "STARFRONTIERS.Item.KitContents"}}</span>
            </div>
            <div class="linked-ability-drop-zone" data-drop-type="kit-content">
              <span>{{localize "STARFRONTIERS.Item.DropKitContent"}}</span>
            </div>
            {{#if kitContentRows.length}}
              <div class="linked-ability-list">
                {{#each kitContentRows as |entry|}}
                  <div class="linked-ability-row">
                    <div class="linked-ability-row__body">
                      <strong>{{entry.name}}</strong>
                      <label>
                        <span>{{localize "STARFRONTIERS.Item.Quantity"}}</span>
                        <input type="number" name="system.contents.{{entry.index}}.quantity" value="{{entry.quantity}}" min="0" />
                      </label>
                      <label>
                        <span>{{localize "STARFRONTIERS.Item.Remaining"}}</span>
                        <input type="number" name="system.contents.{{entry.index}}.remaining" value="{{entry.remaining}}" min="0" />
                      </label>
                      <label class="checkbox-line">
                        <span>{{localize "STARFRONTIERS.Item.ConsumeOnUse"}}</span>
                        <input type="checkbox" name="system.contents.{{entry.index}}.consumeOnUse" {{checked entry.consumeOnUse}} />
                      </label>
                    </div>
                    <button type="button" data-action="removeKitContent" data-index="{{entry.index}}" title="{{localize "STARFRONTIERS.Item.RemoveKitContent"}}">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Item.NoKitContents"}}</p>
            {{/if}}
          </div>
        {{/if}}
      </fieldset>
    {{/if}}

    {{#if is.consumable}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.ConsumableData"}}</legend>
        <div class="compact-grid three-columns">
          <label><span>{{localize "STARFRONTIERS.Item.Uses"}}</span><input type="number" name="system.uses.value" value="{{system.uses.value}}" min="0" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.Max"}}</span><input type="number" name="system.uses.max" value="{{system.uses.max}}" min="0" /></label>
          <label class="checkbox-line"><span>{{localize "STARFRONTIERS.Item.ConsumeOnUse"}}</span><input type="checkbox" name="system.consumeOnUse" {{checked system.consumeOnUse}} /></label>
        </div>
        <div class="ammo-drop-zone">
          <span>{{localize "STARFRONTIERS.Item.RequiredSkill"}}</span>
          <div>
            {{#if linkedRequiredSkill}}
              <strong>{{linkedRequiredSkill.name}}</strong>
              <button type="button" data-action="clearRequiredSkill" title="{{localize "STARFRONTIERS.Item.ClearSkill"}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            {{else}}
              <span>{{localize "STARFRONTIERS.Item.DropSkill"}}</span>
            {{/if}}
          </div>
        </div>
      </fieldset>
    {{/if}}

    {{#if is.vehicle}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.VehicleData"}}</legend>
        <div class="compact-grid five-columns">
          <label><span>{{localize "STARFRONTIERS.Item.VehicleClass"}}</span><input type="text" name="system.vehicleClass" value="{{system.vehicleClass}}" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.Passengers"}}</span><input type="number" name="system.passengers" value="{{system.passengers}}" min="0" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.SpeedSquares"}}</span><input type="number" name="system.speedSquaresPerTurn" value="{{system.speedSquaresPerTurn}}" min="0" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.TurnPenalty"}}</span><input type="number" name="system.turnPenalty" value="{{system.turnPenalty}}" min="0" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.RentalCost"}}</span><input type="number" name="system.rentalCostPerDay" value="{{system.rentalCostPerDay}}" min="0" /></label>
        </div>
        <div class="compact-grid four-columns">
          <label><span>{{localize "STARFRONTIERS.Item.Accel"}}</span><input type="number" name="system.movement.accel" value="{{system.movement.accel}}" min="0" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.Decel"}}</span><input type="number" name="system.movement.decel" value="{{system.movement.decel}}" min="0" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.TopSpeed"}}</span><input type="number" name="system.movement.topSpeed" value="{{system.movement.topSpeed}}" min="0" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.TurnSpeed"}}</span><input type="number" name="system.movement.turnSpeed" value="{{system.movement.turnSpeed}}" min="0" /></label>
        </div>
        <div class="compact-grid three-columns">
          <label><span>{{localize "STARFRONTIERS.Item.ParabatteryType"}}</span><input type="number" name="system.parabatteryType" value="{{system.parabatteryType}}" min="1" max="4" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.RangeKm"}}</span><input type="number" name="system.rangeKm" value="{{system.rangeKm}}" min="0" /></label>
          <label class="checkbox-line"><span>{{localize "STARFRONTIERS.Item.Cover"}}</span><input type="checkbox" name="system.cover" {{checked system.cover}} /></label>
        </div>
        <div class="ammo-drop-zone" data-drop-type="powerSource">
          <span>{{localize "STARFRONTIERS.Item.PowerSource"}}</span>
          <div>
            {{#if linkedVehiclePowerSource}}
              <strong>{{linkedVehiclePowerSource.name}}</strong>
              <span class="linked-ability-row__meta">{{linkedVehiclePowerSource.remaining}}/{{linkedVehiclePowerSource.capacity}} SEU</span>
              <button type="button" data-action="clearVehiclePowerSource" title="{{localize "STARFRONTIERS.Item.ClearPowerSource"}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            {{else}}
              <span>{{localize "STARFRONTIERS.Item.DropPowerSource"}}</span>
            {{/if}}
          </div>
        </div>
      </fieldset>
    {{/if}}

    {{#if is.computer}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.ComputerData"}}</legend>
        <div class="compact-grid two-columns">
          <label><span>{{localize "STARFRONTIERS.Item.Level"}}</span><input type="number" name="system.level" value="{{system.level}}" min="1" max="6" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.FunctionPoints"}}</span><span class="readonly-value">{{system.functionPoints.used}} / {{system.functionPoints.max}}</span></label>
        </div>
        <div class="race-editor-block">
          <div class="race-editor-block__header">
            <span>{{localize "STARFRONTIERS.Item.InstalledPrograms"}}</span>
          </div>
          <div class="linked-ability-drop-zone" data-drop-type="program">
            <span>{{localize "STARFRONTIERS.Item.DropProgram"}}</span>
          </div>
          {{#if linkedComputerPrograms.length}}
            <div class="linked-ability-list">
              {{#each linkedComputerPrograms as |program|}}
                <div class="linked-ability-row">
                  <div class="linked-ability-row__body">
                    <strong>{{program.name}}</strong>
                    <span class="linked-ability-row__meta">{{localize "STARFRONTIERS.Item.Level"}} {{program.level}} — {{program.functionPoints}} {{localize "STARFRONTIERS.Item.FP"}}</span>
                  </div>
                  <button type="button" data-action="unlinkComputerProgram" data-ref="{{program.id}}" title="{{localize "STARFRONTIERS.Item.UnlinkProgram"}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              {{/each}}
            </div>
          {{/if}}
          {{#if functionPointsExceeded}}
            <p class="form-warning">{{localize "STARFRONTIERS.Item.FunctionPointsExceeded"}}</p>
          {{/if}}
        </div>
      </fieldset>
    {{/if}}

    {{#if is.program}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.ProgramData"}}</legend>
        <div class="compact-grid three-columns">
          <label><span>{{localize "STARFRONTIERS.Item.ProgramType"}}</span><select name="system.programType">{{selectOptions choices.programType selected=system.programType localize=true}}</select></label>
          <label><span>{{localize "STARFRONTIERS.Item.Level"}}</span><input type="number" name="system.level" value="{{system.level}}" min="1" max="6" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.FunctionPoints"}}</span><input type="number" name="system.functionPoints" value="{{system.functionPoints}}" min="0" /></label>
        </div>
      </fieldset>
    {{/if}}

    {{#if is.creatureAttack}}
      <fieldset class="paper-box full-width">
        <legend>{{localize "STARFRONTIERS.Item.CreatureAttackData"}}</legend>
        <div class="compact-grid two-columns">
          <label><span>{{localize "STARFRONTIERS.Item.DamageFormula"}}</span><input type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="2d10" /></label>
          <label><span>{{localize "STARFRONTIERS.Item.Defense"}}</span><select name="system.damageType">{{selectOptions choices.damageType selected=system.damageType}}</select></label>
        </div>

        <div class="compact-grid two-columns">
          <label><span>{{localize "STARFRONTIERS.Item.Targets"}}</span><input type="number" name="system.targets" value="{{system.targets}}" min="1" /></label>
          <label class="checkbox-line"><span>{{localize "STARFRONTIERS.Item.HasRange"}}</span><input type="checkbox" name="system.range.enabled" {{checked system.range.enabled}} /></label>
        </div>

        {{#if system.range.enabled}}
          <div class="range-editor">
            <span></span>
            <span>{{localize "STARFRONTIERS.Item.RangeMin"}}</span>
            <span>{{localize "STARFRONTIERS.Item.RangeMax"}}</span>
            <span>{{localize "STARFRONTIERS.Item.RangeDamage"}}</span>
            {{#each rangeRows as |row|}}
              <span>{{row.label}}</span>
              <input type="number" name="system.range.rangeBands.{{row.key}}.min" value="{{row.band.min}}" min="0" />
              <input type="number" name="system.range.rangeBands.{{row.key}}.max" value="{{row.band.max}}" min="0" />
              <input type="text" name="system.range.rangeBands.{{row.key}}.damageFormula" value="{{row.band.damageFormula}}" placeholder="—" />
            {{/each}}
          </div>
        {{/if}}

        <fieldset class="paper-box">
          <legend>{{localize "STARFRONTIERS.Item.Avoidance"}}</legend>
          <div class="compact-grid two-columns">
            <label class="checkbox-line">
              <span>{{localize "STARFRONTIERS.Weapon.AvoidanceEnabled"}}</span>
              <input type="checkbox" name="system.avoidance.enabled" {{checked system.avoidance.enabled}} />
            </label>
            <label>
              <span>{{localize "STARFRONTIERS.Weapon.AvoidanceAbility"}}</span>
              <select name="system.avoidance.ability">{{selectOptions avoidanceAbilityChoices selected=system.avoidance.ability}}</select>
            </label>
          </div>
          <div class="compact-grid two-columns">
            <label>
              <span>{{localize "STARFRONTIERS.Weapon.AvoidanceOnSuccessEffect"}}</span>
              <input type="text" name="system.avoidance.onSuccessEffect" value="{{system.avoidance.onSuccessEffect}}" />
            </label>
            <label>
              <span>{{localize "STARFRONTIERS.Weapon.AvoidanceFailNote"}}</span>
              <input type="text" name="system.avoidance.failNote" value="{{system.avoidance.failNote}}" />
            </label>
          </div>
        </fieldset>

        <div class="race-editor-block">
          <div class="race-editor-block__header">
            <span>{{localize "STARFRONTIERS.Weapon.ModeOnHitEffects"}}</span>
            <button type="button" data-action="addCreatureAttackEffect">
              <i class="fa-solid fa-plus"></i>
              <span>{{localize "STARFRONTIERS.Item.AddEffect"}}</span>
            </button>
          </div>
          {{#if creatureAttackOnHitEffectRows.length}}
            <div class="linked-ability-list">
              {{#each creatureAttackOnHitEffectRows as |effectRow|}}
                <div class="linked-ability-row">
                  <div class="linked-ability-row__body">
                    <button
                      type="button"
                      class="linked-ability-row__toggle"
                      data-action="openEffect"
                      data-effect-id="{{effectRow.effectId}}"
                      data-effect-ref="{{effectRow.id}}"
                    >{{effectRow.name}}</button>
                    {{#if effectRow.sourceName}}
                      <span class="linked-ability-row__meta">{{effectRow.sourceName}}</span>
                    {{/if}}
                  </div>
                  <button
                    type="button"
                    data-action="removeCreatureAttackEffect"
                    data-effect-id="{{effectRow.id}}"
                    title="{{localize "STARFRONTIERS.Weapon.RemoveOnHitEffect"}}"
                  >
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="race-editor-block__empty">{{localize "STARFRONTIERS.Weapon.NoOnHitEffects"}}</p>
          {{/if}}
        </div>
      </fieldset>
    {{/if}}
  </main>
</section>

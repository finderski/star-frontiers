<form class="star-frontiers attack-dialog" autocomplete="off">
  <input type="hidden" name="activeShotIndex" value="{{activeShotIndex}}" />

  <section
    class="attack-dialog__blocker-banner sf-attack-blocker-banner"
    data-attack-dialog-blocker-banner
    {{#unless blockers.length}}hidden{{/unless}}
  >
    <i class="fa-solid fa-circle-exclamation"></i>
    <div class="sf-attack-blocker-banner__body">
      <div class="sf-attack-blocker-banner__messages" data-attack-dialog-blocker-messages>
        {{#each blockers as |blocker|}}
          <p>{{localize "STARFRONTIERS.Combat.BlockerMessage" label=blocker.label}}</p>
        {{/each}}
      </div>
      <div class="sf-attack-blocker-banner__overrides">
        {{#if isGM}}
          <label>
            <input type="checkbox" name="gmOverrideBlocker" />
            <span>{{localize "STARFRONTIERS.Combat.GMOverrideBlocker"}}</span>
          </label>
        {{/if}}
        {{#if showPlayerOverride}}
          <label>
            <input type="checkbox" name="playerOverrideBlocker" />
            <span>{{localize "STARFRONTIERS.Combat.PlayerOverrideBlocker"}}</span>
          </label>
        {{/if}}
      </div>
    </div>
  </section>

  <section class="attack-dialog__summary">
    <div class="attack-dialog__identity">
      <div class="attack-dialog__identity-row">
        <span class="attack-dialog__identity-label">{{localize "STARFRONTIERS.Chat.AttackerLabel"}}</span>
        <span class="attack-dialog__identity-value">{{attackerName}}</span>
      </div>
      <div class="attack-dialog__identity-row">
        <span class="attack-dialog__identity-label">{{localize "STARFRONTIERS.Chat.TargetLabel"}}</span>
        <span class="attack-dialog__identity-value">{{targetName}}</span>
      </div>
    </div>

    <div class="attack-dialog__totals">
      <div class="attack-dialog__total">
        <span class="label">{{localize "STARFRONTIERS.Chat.BaseChance"}}</span>
        <span class="value" data-attack-dialog-base-chance>{{baseChance}}</span>
      </div>
      <div class="attack-dialog__total">
        <span class="label">{{localize "STARFRONTIERS.Chat.TargetNumber"}}</span>
        <span class="value" data-attack-dialog-target-number>{{targetNumber}}</span>
      </div>
    </div>
  </section>

  <section class="attack-dialog__modifiers">
    <h3>{{localize "STARFRONTIERS.Chat.DialogInputs"}}</h3>

    <div class="attack-dialog__subsection">
      <h4 class="attack-dialog__subheading">{{localize "STARFRONTIERS.Combat.AppliesToAllShots"}}</h4>
      <div data-attack-dialog-shared-rows>
        {{{sharedModifierRowsHtml}}}
      </div>

      <div class="attack-dialog__shared-controls">
        {{#if showMeleeAbility}}
          <label class="attack-dialog__field attack-dialog__field--wide">
            <span>{{localize "STARFRONTIERS.Modifier.MeleeAttackAbility"}}</span>
            <select class="attack-dialog__inline-select" name="meleeAttackAbility">
              {{selectOptions meleeAbilityOptions selected=meleeAttackAbilitySelected nameAttr="value" labelAttr="label"}}
            </select>
          </label>
        {{/if}}

        {{#if showAttackerMovementControl}}
          <label class="attack-dialog__field attack-dialog__field--wide">
            <span>{{localize "STARFRONTIERS.Modifier.AttackerMovement"}}</span>
            <select class="attack-dialog__inline-select" name="attackerMovement">
              {{selectOptions attackerMovementOptions selected=attackerMovementSelected nameAttr="value" labelAttr="label"}}
            </select>
          </label>
        {{/if}}

        {{#if showWrongHand}}
          <label class="attack-dialog__field attack-dialog__field--checkbox">
            <input class="attack-dialog__inline-checkbox" type="checkbox" name="wrongHand" {{checked wrongHand}} {{#if dialogCheckboxDisabled}}disabled{{/if}} />
            <span>{{localize "STARFRONTIERS.Modifier.WrongHand"}} (-10)</span>
          </label>
        {{/if}}

        {{#if showFiringTwoWeapons}}
          <label class="attack-dialog__field attack-dialog__field--checkbox">
            <input class="attack-dialog__inline-checkbox" type="checkbox" name="firingTwoWeapons" {{checked firingTwoWeapons}} {{#if dialogCheckboxDisabled}}disabled{{/if}} />
            <span>{{localize "STARFRONTIERS.Modifier.FiringTwoWeapons"}} (-10)</span>
          </label>
        {{/if}}

        <label class="attack-dialog__field attack-dialog__field--manual">
          <span>{{localize "STARFRONTIERS.Modifier.GMCircumstance"}}</span>
          <input class="attack-dialog__inline-input" type="text" name="gmCircumstanceLabel" value="{{gmCircumstanceLabel}}" />
          <input class="attack-dialog__inline-input" type="number" name="gmCircumstanceValue" value="{{gmCircumstanceValue}}" step="1" />
        </label>

        <label class="attack-dialog__field attack-dialog__field--manual">
          <span>{{localize "STARFRONTIERS.Modifier.MiscModifier"}}</span>
          <input class="attack-dialog__inline-input" type="text" name="miscModifierLabel" value="{{miscModifierLabel}}" />
          <input class="attack-dialog__inline-input" type="number" name="miscModifierValue" value="{{miscModifierValue}}" step="1" />
        </label>
      </div>
    </div>

    <div class="attack-dialog__warnings" data-attack-dialog-warnings>
      {{{warningsHtml}}}
    </div>
    {{#if showPerShotSection}}
      <div class="attack-dialog__subsection">
        <div class="attack-dialog__per-shot-header">
          <h4 class="attack-dialog__subheading">{{localize "STARFRONTIERS.Combat.PerShot"}}</h4>
          <label class="attack-dialog__field attack-dialog__field--shots">
            <span>{{localize "STARFRONTIERS.Combat.Shots"}}</span>
            <input class="attack-dialog__inline-input" type="number" name="shots" value="{{shots}}" min="1" max="{{maxShots}}" step="1" />
            <small class="form-hint">{{localize "STARFRONTIERS.Combat.ROFHint" rof=maxShots}}</small>
          </label>
        </div>

        <div class="attack-dialog__shot-tabs" role="tablist" data-attack-dialog-shot-tabs>
          {{{shotTabsHtml}}}
        </div>

        <div data-attack-dialog-shot-panels>
          {{{shotPanelsHtml}}}
        </div>
      </div>
    {{/if}}
  </section>

  {{#if forcedField}}
    <section class="attack-dialog__controls attack-dialog__controls--manual">
      <h3>{{localize "STARFRONTIERS.Chat.GMTesting"}}</h3>
      {{{forcedField}}}
    </section>
  {{/if}}
</form>
